{
  "name": "@nico2433/utils",
  "version": "2.0.1",
  "description": "Some utils for javascript projects",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check:package": "publint --strict && attw --pack"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nico2433/utils.git"
  },
  "author": "nico2433",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nico2433/utils/issues"
  },
  "homepage": "https://github.com/Nico2433/utils#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "packageManager": "pnpm@12.11.2"
}
